---
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import OptimizedImage from "./OptimizedImage.astro";
import type { ImageMetadata } from "astro";
interface Props { image?: ImageMetadata; imageAlt?: string; tone?: "plum" | "olive"; icon?: IconName; signature?: string; }
const { image, imageAlt = "", tone = "plum", icon = "sparkles", signature } = Astro.props as Props;
---

<blockquote class:list={["quote-banner", `quote-banner--${tone}`, { "quote-banner--with-image": image }]}>
  <div class="quote-banner__copy"><p><slot /></p><Icon name={icon} size={24} />{signature && <span class="quote-banner__signature">{signature}</span>}</div>
  {image && <div class="quote-banner__media"><OptimizedImage src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(max-width: 640px) 0px, 50vw" /></div>}
</blockquote>

<style>
  .quote-banner { background: var(--color-pflaume); color: var(--color-kalk); display: grid; margin: 0; }
  .quote-banner--olive { background: var(--color-olive-dark); }
  .quote-banner--with-image { grid-template-columns: 1fr 1fr; }
  .quote-banner__copy { align-items: center; display: flex; flex-direction: column; justify-content: center; padding: 3.85rem var(--space-10); text-align: center; }
  .quote-banner__copy p { color: inherit; font-family: var(--font-display); font-size: var(--text-xl); line-height: var(--leading-tight); margin: 0 0 var(--space-6); max-width: 24ch; }
  .quote-banner__signature { font-family: var(--font-script); font-size: var(--text-lg); margin-top: var(--space-3); }
  .quote-banner__media { min-height: 0; overflow: hidden; position: relative; }
  .quote-banner__media :global(picture), .quote-banner__media :global(img) { height: 100%; inset: 0; position: absolute; width: 100%; }
  .quote-banner__media :global(img) { object-fit: cover; }
  @media (max-width: 40rem) { .quote-banner--with-image { grid-template-columns: 1fr; } .quote-banner__media { display: none; } }
</style>
