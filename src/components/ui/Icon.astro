---
import {
  ArrowRight,
  Bookmark,
  Cake,
  CalendarDays,
  Camera,
  Clock,
  CookingPot,
  Heart,
  HeartHandshake,
  Leaf,
  ListChecks,
  Mail,
  Menu,
  MessageCircle,
  Pin,
  Printer,
  Quote,
  Search,
  Salad,
  Share2,
  Sparkles,
  PartyPopper,
  Star,
  Users,
  X,
} from "@lucide/astro";

const icons = {
  "arrow-right": ArrowRight,
  bookmark: Bookmark,
  cake: Cake,
  calendar: CalendarDays,
  clock: Clock,
  "cooking-pot": CookingPot,
  heart: Heart,
  "heart-handshake": HeartHandshake,
  instagram: Camera,
  leaf: Leaf,
  "list-check": ListChecks,
  mail: Mail,
  menu: Menu,
  "message-circle": MessageCircle,
  pin: Pin,
  printer: Printer,
  quote: Quote,
  search: Search,
  salad: Salad,
  "share-2": Share2,
  sparkles: Sparkles,
  "party-popper": PartyPopper,
  star: Star,
  users: Users,
  x: X,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  title?: string;
}

const { name, size = 20, title } = Astro.props;
const LucideIcon = icons[name];
---

<LucideIcon
  size={size}
  stroke-width={1.6}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  role={title ? "img" : undefined}
/>
