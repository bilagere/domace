---
interface Item { label: string; href: string; }
interface Props { items: Item[]; active?: string; }
const { items, active } = Astro.props;
---

<nav class="category-nav" aria-label="Unterkategorien">
  <ul>
    {items.map((item) => (
      <li><a class:list={{ "is-active": item.label === active }} href={item.href} aria-current={item.label === active ? "page" : undefined}>{item.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .category-nav { border-block: var(--divider-thickness) solid var(--color-divider); overflow-x: auto; }
  ul { display: flex; gap: clamp(var(--space-5), 4vw, var(--space-10)); list-style: none; margin: 0; min-width: max-content; padding: 0; }
  a { color: var(--color-text); display: block; font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); padding: var(--space-5) 0; text-decoration: none; text-transform: uppercase; }
  a:hover, a.is-active { color: var(--color-terracotta); }
  a.is-active { border-bottom: var(--divider-thickness) solid currentColor; }
  @media (max-width: 40rem) {
    .category-nav { overflow: visible; }
    ul { display: grid; gap: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); min-width: 0; }
    li { border-left: var(--divider-thickness) solid var(--color-border); min-width: 0; }
    li:first-child { border-left: 0; }
    a { padding: var(--space-4) var(--space-2); text-align: center; }
  }
</style>
