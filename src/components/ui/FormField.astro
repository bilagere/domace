---
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: "email" | "text" | "search";
  autocomplete?: string;
  placeholder?: string;
  required?: boolean;
  hiddenLabel?: boolean;
  hint?: string;
}

const {
  id,
  label,
  name = id,
  type = "text",
  autocomplete,
  placeholder,
  required = false,
  hiddenLabel = false,
  hint,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class="form-field">
  <label class:list={{ "sr-only": hiddenLabel }} for={id}>{label}</label>
  <input
    id={id}
    name={name}
    type={type}
    autocomplete={autocomplete}
    placeholder={placeholder}
    required={required}
    aria-describedby={hintId}
  />
  {hint && <p id={hintId} class="form-field__hint">{hint}</p>}
</div>

<style>
  .form-field { min-width: 0; }
  label:not(.sr-only) { color: var(--color-text); display: block; font-size: var(--text-sm); font-weight: var(--font-weight-semibold); margin-bottom: var(--space-2); }
  input { background: var(--color-surface-raised); border: 1px solid var(--color-border); min-height: var(--control-height); padding: 0 var(--space-4); width: 100%; }
  input::placeholder { color: var(--color-text-muted); opacity: 1; }
  .form-field__hint { color: var(--color-text-muted); font-size: var(--text-xs); margin-top: var(--space-2); }
</style>
