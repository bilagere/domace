---
import Icon from "./Icon.astro";
type IconName = "users" | "leaf" | "heart" | "mail";
interface Item { icon: IconName; title: string; description?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<ul class="feature-list">
  {items.map((item) => (
    <li>
      <Icon name={item.icon} size={32} />
      <h3>{item.title}</h3>
      {item.description && <p>{item.description}</p>}
    </li>
  ))}
</ul>

<style>
  .feature-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); list-style: none; margin: 0; padding: 0; }
  li { border-left: var(--divider-thickness) solid var(--color-divider); padding: var(--space-4) var(--space-5); text-align: center; }
  li:first-child { border-left: 0; }
  svg { color: var(--color-olive-dark); }
  h3 { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.07em; margin-top: var(--space-3); text-transform: uppercase; }
  p { font-size: var(--text-sm); margin-top: var(--space-2); }
  @media (max-width: 34rem) { li:nth-child(odd) { border-left: 0; } }
</style>
