---
import MetaList from "./MetaList.astro";
import OptimizedImage from "./OptimizedImage.astro";
import type { ImageMetadata } from "astro";

interface MetaItem { icon: "clock" | "users" | "leaf"; label: string; value?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  summary?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePlaceholder?: string;
  meta?: MetaItem[];
  contentAlign?: "center" | "start";
}
const { eyebrow, title, summary, image, imageAlt = "", imagePlaceholder, meta = [], contentAlign = "center" } = Astro.props;
---

<header class="article-lead">
  <div class:list={["article-lead__content", `article-lead__content--${contentAlign}`]}>
    {eyebrow && <p class="article-lead__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {summary && <p class="article-lead__summary">{summary}</p>}
    {meta.length > 0 && <div class="article-lead__meta"><MetaList items={meta} /></div>}
  </div>
  {(image || imagePlaceholder) && (
    <div class:list={["article-lead__media", { "article-lead__media--placeholder": !image }]}>
      {image ? (
        <OptimizedImage
          src={image}
          alt={imageAlt}
          widths={[480, 640, 800, 960]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <p>{imagePlaceholder}</p>
      )}
    </div>
  )}
</header>

<style>
  .article-lead { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr); }
  .article-lead__media { min-height: 31rem; overflow: hidden; }
  .article-lead__media :global(picture), .article-lead__media :global(img) { height: 100%; width: 100%; }
  .article-lead__media :global(img) { object-fit: cover; }
  .article-lead__media--placeholder { align-items: center; background: var(--color-surface-muted); display: flex; justify-content: center; }
  .article-lead__media--placeholder p { color: var(--color-olive-dark); font-size: var(--text-xs); font-weight: var(--font-weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .article-lead__content { align-content: center; display: grid; border-bottom: var(--divider-thickness) solid var(--color-divider); padding: var(--space-10) var(--space-12) var(--space-10) 0; }
  .article-lead__content--start { align-content: start; padding-top: var(--space-10); }
  .article-lead__eyebrow { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  h1 { font-size: var(--text-2xl); margin-top: var(--space-3); }
  .article-lead__summary { font-size: var(--text-lg); margin-top: var(--space-5); max-width: var(--content-narrow); }
  .article-lead__meta { border-top: var(--divider-thickness) solid var(--color-divider); margin-top: var(--space-6); padding-top: var(--space-4); }
  @media (max-width: 64rem) {
    .article-lead { grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.8fr); }
    .article-lead__content { padding-right: var(--space-8); }
  }
  @media (max-width: 48rem) {
    .article-lead { grid-template-columns: 1fr; }
    .article-lead__content { padding: var(--space-8) 0; }
    .article-lead__media { aspect-ratio: 1.15; min-height: 0; }
  }
  @media print {
    .article-lead { display: grid !important; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) !important; }
    .article-lead__content { padding: var(--space-5) var(--space-6) var(--space-5) 0; }
    .article-lead__media { aspect-ratio: auto; height: 7.5cm; min-height: 0; }
  }
</style>