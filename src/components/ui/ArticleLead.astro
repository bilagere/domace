---
import Icon from "./Icon.astro";
import MetaList from "./MetaList.astro";

interface MetaItem { icon: "clock" | "users" | "leaf"; label: string; value?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  summary?: string;
  image?: string;
  imageAlt?: string;
  meta?: MetaItem[];
}
const { eyebrow, title, summary, image, imageAlt = "", meta = [] } = Astro.props;
---

<header class="article-lead">
  {image && <img class="article-lead__image" src={image} alt={imageAlt} />}
  <div class="article-lead__content">
    {eyebrow && <p class="article-lead__eyebrow">{eyebrow}</p>}
    <h1>{title} <Icon name="heart" size={29} /></h1>
    {summary && <p class="article-lead__summary">{summary}</p>}
    {meta.length > 0 && <div class="article-lead__meta"><MetaList items={meta} /></div>}
  </div>
</header>

<style>
  .article-lead__image { aspect-ratio: 1.8; display: block; object-fit: cover; width: 100%; }
  .article-lead__content { border-bottom: var(--divider-thickness) solid var(--color-divider); padding: var(--space-8) 0; }
  .article-lead__eyebrow { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  h1 { font-size: var(--text-2xl); margin-top: var(--space-3); }
  h1 :global(svg) { color: var(--color-terracotta); display: inline-block; margin-left: var(--space-2); vertical-align: 0.05em; }
  .article-lead__summary { font-size: var(--text-lg); margin-top: var(--space-5); max-width: 40rem; }
  .article-lead__meta { border-top: var(--divider-thickness) solid var(--color-divider); margin-top: var(--space-6); padding-top: var(--space-4); }
</style>
