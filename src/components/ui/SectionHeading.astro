---
import Icon from "./Icon.astro";
import Divider from "./Divider.astro";

interface Props {
  eyebrow?: string;
  centered?: boolean;
  ornament?: boolean;
}

const { eyebrow, centered = false, ornament = false } = Astro.props;
---

<header class:list={["section-heading", { "section-heading--centered": centered }]}>
  {ornament && <span class="section-heading__ornament"><Icon name="heart" size={24} /></span>}
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2><slot /></h2>
  <div class="section-heading__rule"><Divider /></div>
</header>

<style>
  .section-heading { color: var(--color-text); }
  .section-heading--centered { text-align: center; }
  .section-heading__ornament { color: var(--color-terracotta); display: block; margin-bottom: var(--space-2); }
  .section-heading--centered .section-heading__ornament { display: flex; justify-content: center; }
  .section-heading__eyebrow { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); margin-bottom: var(--space-3); text-transform: uppercase; }
  h2 { font-size: var(--text-2xl); }
  .section-heading__rule { margin-top: var(--space-5); }
  .section-heading--centered .section-heading__rule { margin-inline: auto; }
</style>
