---
interface Props { title?: string; steps: string[]; note?: string; }
const { title = "Zubereitung", steps, note } = Astro.props;
---

<section class="numbered-steps">
  <h2>{title}</h2>
  <ol>{steps.map((step) => <li>{step}</li>)}</ol>
  {note && <p class="numbered-steps__note">{note}</p>}
</section>

<style>
  h2 { font-size: var(--text-lg); }
  ol { counter-reset: steps; list-style: none; margin: var(--space-5) 0 0; padding: 0; }
  li { color: var(--color-text-muted); counter-increment: steps; font-size: var(--text-sm); line-height: var(--leading-relaxed); padding-left: 2.25rem; position: relative; }
  li + li { margin-top: var(--space-4); }
  li::before { align-items: center; background: var(--color-olive-dark); border-radius: 50%; color: var(--color-kalk); content: counter(steps); display: flex; font-size: var(--text-xs); height: 1.4rem; justify-content: center; left: 0; position: absolute; top: 0.15rem; width: 1.4rem; }
  .numbered-steps__note { font-family: var(--font-script); margin-top: var(--space-6); }
</style>
