---
interface Item { label: string; href: string; }
interface Props { items: Item[]; title?: string; }
const { items, title = "In diesem Artikel" } = Astro.props;
---

<nav class="table-of-contents" aria-label={title}>
  <p>{title}</p>
  <ol>{items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ol>
</nav>

<style>
  .table-of-contents { border-block: var(--divider-thickness) solid var(--color-divider); padding-block: var(--space-5); }
  p { color: var(--color-text); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  ol { counter-reset: toc; list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  li { border-bottom: var(--divider-thickness) solid var(--color-divider); counter-increment: toc; padding: var(--space-3) 0; }
  li::before { color: var(--color-terracotta); content: counter(toc) "."; font-size: var(--text-sm); margin-right: var(--space-3); }
  a { color: var(--color-text); font-size: var(--text-sm); text-decoration: none; }
  a:hover { color: var(--color-terracotta); }
</style>
