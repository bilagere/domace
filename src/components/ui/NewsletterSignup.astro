---
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  compact?: boolean;
}

const {
  eyebrow = "Post für dich",
  title = "Schönes für den Alltag.",
  description = "Erhalte regelmäßig neue Beiträge, Rezepte und Ideen direkt in dein Postfach.",
  compact = false,
} = Astro.props;
---

<section class:list={["newsletter", { "newsletter--compact": compact }]} aria-labelledby="newsletter-title">
  <div class="newsletter__copy">
    <span class="newsletter__icon"><Icon name="mail" size={34} /></span>
    <div>
      <p class="newsletter__eyebrow">{eyebrow}</p>
      <h2 id="newsletter-title">{title}</h2>
      <p>{description}</p>
    </div>
  </div>
  {compact && <Badge label="Keine Post" caption="verpassen" />}
  <div class="newsletter__form" data-newsletter-form>
    <div class="newsletter__gate" data-newsletter-gate>
      <Button class="newsletter__load" ariaLabel="Newsletter-Anmeldung von beehiiv laden">Newsletter-Anmeldung öffnen</Button>
      <p class="newsletter__privacy">Das Formular wird von beehiiv bereitgestellt und erst nach deinem Klick geladen. Dabei können Verbindungsdaten verarbeitet und ein Attributions-Cookie gesetzt werden. <a href="/datenschutz">Mehr zum Datenschutz</a>.</p>
    </div>
  </div>
  <script>
    document.querySelectorAll<HTMLElement>("[data-newsletter-form]").forEach((form) => {
      const gate = form.querySelector<HTMLElement>("[data-newsletter-gate]");
      const button = gate?.querySelector<HTMLButtonElement>("button");

      button?.addEventListener("click", () => {
        const script = document.createElement("script");
        script.src = "https://subscribe-forms.beehiiv.com/v3/loader.js";
        script.async = true;
        script.dataset.beehiivForm = "8c271560-80d4-4e4e-8627-95a34485ca88";
        gate?.remove();
        form.append(script);
      }, { once: true });
    });

    const labelNewsletterFrames = () => {
      document.querySelectorAll<HTMLIFrameElement>(
        'iframe[src*="subscribe-forms.beehiiv.com"]',
      ).forEach((frame) => {
        if (!frame.title) frame.title = "Newsletter-Anmeldung bei Domaće";
      });
    };

    labelNewsletterFrames();
    const newsletterObserver = new MutationObserver(labelNewsletterFrames);
    newsletterObserver.observe(document.body, { childList: true, subtree: true });
    window.setTimeout(() => newsletterObserver.disconnect(), 10_000);
  </script>
  {compact && <p class="newsletter__signature">Ich freue mich auf dich! xo, Mara</p>}
</section>

<style>
  .newsletter { align-items: center; background: var(--color-surface-muted); border: 1px solid var(--color-border); display: grid; gap: var(--space-8); grid-template-columns: 1fr 1fr; padding: clamp(var(--space-6), 4vw, var(--space-12)); }
  .newsletter__copy { align-items: flex-start; display: flex; gap: var(--space-5); }
  .newsletter__icon { color: var(--color-olive-dark); flex: 0 0 auto; }
  .newsletter__eyebrow { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  h2 { font-size: var(--text-xl); margin: var(--space-1) 0 var(--space-2); }
  .newsletter__form { min-height: 4.5rem; width: 100%; }
  .newsletter__gate { align-items: flex-start; display: flex; flex-direction: column; gap: var(--space-3); }
  .newsletter__privacy { color: var(--color-text-muted); font-size: var(--text-xs); line-height: var(--leading-relaxed); max-width: 34rem; }
  .newsletter__privacy a { color: var(--color-action); }
  .newsletter__form :global(iframe) { border: 0; display: block; max-width: 100%; width: 100%; }
  .newsletter--compact { align-content: center; display: grid; gap: var(--space-4) clamp(var(--space-6), 4vw, var(--space-12)); grid-template-areas: "copy badge" "form badge" "signature badge"; grid-template-columns: minmax(0, 34rem) auto; justify-content: space-between; padding: clamp(var(--space-6), 3.5vw, var(--space-10)); position: relative; }
  .newsletter--compact .newsletter__copy { grid-area: copy; }
  .newsletter--compact .newsletter__icon { display: none; }
  .newsletter--compact :global(.badge) { align-self: center; grid-area: badge; }
  .newsletter--compact .newsletter__form { grid-area: form; max-width: 34rem; min-height: 0; }
  .newsletter__signature { align-items: center; color: var(--color-text); display: flex; font-family: var(--font-script); font-size: var(--text-lg); gap: var(--space-2); grid-area: signature; margin-top: var(--space-2); }
  @media (max-width: 42rem) {
    .newsletter { grid-template-columns: 1fr; }
    .newsletter--compact { display: block; }
    .newsletter--compact :global(.badge) { position: absolute; right: var(--space-6); top: var(--space-6); width: 6.5rem; }
    .newsletter--compact .newsletter__copy { margin-bottom: var(--space-4); padding-right: 6rem; }
    .newsletter__signature { margin-top: var(--space-5); }
  }
</style>
