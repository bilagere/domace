---
import Button from "./Button.astro";

interface Props {
  name: string;
  image: string;
  imageAlt?: string;
  description: string;
  href?: string;
  compact?: boolean;
}
const { name, image, imageAlt = "", description, href, compact = false } = Astro.props;
---

<section class:list={["author-card", { "author-card--compact": compact }]}>
  <img src={image} alt={imageAlt} loading="lazy" />
  <div>
    <p class="author-card__eyebrow">Über die Autorin</p>
    <h2>Ich bin {name}.</h2>
    <p>{description}</p>
    {href && <Button href={href} variant="text" icon>Mehr über mich</Button>}
  </div>
</section>

<style>
  .author-card { align-items: start; background: var(--color-surface-muted); display: grid; gap: var(--space-5); grid-template-columns: 7rem 1fr; padding: var(--space-6); }
  img { aspect-ratio: 1; border-radius: 50%; object-fit: cover; width: 100%; }
  .author-card__eyebrow { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  h2 { font-size: var(--text-xl); margin: var(--space-2) 0; }
  p { font-size: var(--text-sm); }
  :global(.button) { margin-top: var(--space-4); }
  .author-card--compact { display: block; text-align: center; }
  .author-card--compact img { margin: 0 auto var(--space-4); max-width: 7rem; }
  @media (max-width: 24rem) { .author-card { grid-template-columns: 1fr; text-align: center; } img { margin: 0 auto; max-width: 7rem; } }
</style>
