---
import Icon from "./Icon.astro";

type IconName = "bookmark" | "heart" | "message-circle" | "printer" | "share-2" | "star";
interface Item { label: string; icon: IconName; href: string; }
interface Props { items: Item[]; label?: string; }
const { items, label = "Artikelaktionen" } = Astro.props;
---

<nav class="action-list" aria-label={label}>
  <ul>
    {items.map((item) => <li><a href={item.href}><Icon name={item.icon} size={17} /><span>{item.label}</span></a></li>)}
  </ul>
</nav>

<style>
  ul { display: grid; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  a { align-items: center; color: var(--color-text); display: inline-flex; font-size: var(--text-sm); gap: var(--space-3); text-decoration: none; }
  a:hover { color: var(--color-terracotta); }
  :global(svg) { color: var(--color-olive-dark); flex: 0 0 auto; }
</style>
