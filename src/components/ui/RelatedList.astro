---
interface Item { title: string; href: string; image?: string; meta?: string; }
interface Props { title?: string; items: Item[]; link?: { label: string; href: string }; }
const { title = "Das könnte dich auch interessieren", items, link } = Astro.props;
---

<section class="related-list">
  <h2>{title}</h2>
  <ul>
    {items.map((item) => (
      <li>
        {item.image && <img src={item.image} alt="" loading="lazy" />}
        <div>{item.meta && <p>{item.meta}</p>}<a href={item.href}>{item.title}</a></div>
      </li>
    ))}
  </ul>
  {link && <a class="related-list__all" href={link.href}>{link.label} →</a>}
</section>

<style>
  h2 { font-size: var(--text-lg); }
  ul { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  li { align-items: center; display: grid; gap: var(--space-3); grid-template-columns: 4rem 1fr; }
  li + li { border-top: var(--divider-thickness) solid var(--color-divider); margin-top: var(--space-3); padding-top: var(--space-3); }
  img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  p { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  li a { color: var(--color-text); font-family: var(--font-display); font-size: var(--text-base); line-height: 1.15; text-decoration: none; }
  .related-list__all { color: var(--color-terracotta); display: inline-block; font-size: var(--text-xs); font-weight: 700; margin-top: var(--space-5); text-decoration: none; }
</style>
