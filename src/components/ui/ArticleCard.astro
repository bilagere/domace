---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import MetaList from "./MetaList.astro";
import OptimizedImage from "./OptimizedImage.astro";
import type { ArticlePreview } from "../../types/content";

interface Props extends ArticlePreview {
  featured?: boolean;
}

const { title, excerpt, category, image, href, date, duration, servings, featured = false } = Astro.props;
const details = [
  ...(duration ? [{ icon: "clock" as const, label: duration }] : []),
  ...(servings ? [{ icon: "users" as const, label: servings }] : []),
];
---

<article class:list={["article-card", { "article-card--featured": featured }]}>
  <a class:list={["article-card__image", { "article-card__image--placeholder": !image }]} href={href} aria-label={`Artikel öffnen: ${title}`}>
    {image ? (
      <OptimizedImage src={image} alt="" widths={[320, 480, 640, 800]} sizes="(max-width: 736px) 100vw, 33vw" />
    ) : (
      <span class="article-card__placeholder"><Icon name="cooking-pot" size={30} /><span>Bild folgt</span></span>
    )}
  </a>
  <div class="article-card__body">
    <p class="article-card__meta">{category}{date && <span>· {date}</span>}</p>
    <h3><a href={href}>{title}</a></h3>
    <p class="article-card__excerpt">{excerpt}</p>
    {details.length > 0 && <div class="article-card__details"><MetaList items={details} compact /></div>}
    <Button href={href} variant="text" icon>Weiterlesen</Button>
  </div>
</article>

<style>
  .article-card { background: var(--color-surface-raised); border: 1px solid var(--color-border); display: flex; flex-direction: column; height: 100%; }
  .article-card__image { aspect-ratio: 1.25; display: block; overflow: hidden; }
  .article-card__image :global(picture), .article-card__image :global(img) { height: 100%; width: 100%; }
  .article-card__image :global(img) { object-fit: cover; transition: transform 320ms ease; }
  .article-card:hover .article-card__image :global(img) { transform: scale(1.03); }
  .article-card__image--placeholder { align-items: center; background: var(--color-surface-muted); display: flex; justify-content: center; text-decoration: none; }
  .article-card__placeholder { align-items: center; color: var(--color-olive-dark); display: flex; flex-direction: column; font-size: var(--text-xs); font-weight: var(--font-weight-bold); gap: var(--space-3); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .article-card__body { align-items: flex-start; display: flex; flex: 1; flex-direction: column; padding: var(--space-5); }
  .article-card__meta { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  h3 { font-size: var(--text-xl); margin-top: var(--space-3); }
  h3 a { text-decoration: none; }
  .article-card__excerpt { font-size: var(--text-sm); margin-top: var(--space-3); }
  .article-card__details { margin: var(--space-5) 0 var(--space-4); width: 100%; }
  .article-card__body :global(.button) { margin-top: auto; }
  .article-card--featured { border: 0; }
</style>