---
import Icon from "./Icon.astro";
import MetaList from "./MetaList.astro";
import OptimizedImage from "./OptimizedImage.astro";
import type { ArticlePreview } from "../../types/content";

interface Props extends ArticlePreview {
  featured?: boolean;
}

const { title, excerpt, category, image, href, date, duration, servings, featured = false } = Astro.props;
const normalizedCategory = category.toLocaleLowerCase("en");
const tone = normalizedCategory.includes("home")
  ? "salbei"
  : normalizedCategory.includes("rhythm")
    ? "sonne"
    : normalizedCategory.includes("family")
      ? "mauve"
      : "lehm";
const details = [
  ...(date ? [{ icon: "calendar" as const, label: date }] : []),
  ...(duration ? [{ icon: "clock" as const, label: duration }] : []),
  ...(servings ? [{ icon: "users" as const, label: servings }] : []),
];
---

<article class:list={["article-card", `article-card--${tone}`, { "article-card--featured": featured }]}>
  <a class:list={["article-card__image", { "article-card__image--placeholder": !image }]} href={href} aria-label={`Open article: ${title}`}>
    {image ? (
      <OptimizedImage src={image} alt="" widths={[320, 480, 640, 800]} sizes="(max-width: 736px) 100vw, 33vw" />
    ) : (
      <span class="article-card__placeholder"><Icon name="cooking-pot" size={30} /><span>Image coming soon</span></span>
    )}
    <span class="article-card__meta">{category}</span>
  </a>
  <div class="article-card__body">
    <h3><a href={href}>{title}</a></h3>
    <p class="article-card__excerpt">{excerpt}</p>
    {details.length > 0 && <div class="article-card__details"><MetaList items={details} compact /></div>}
  </div>
</article>

<style>
  .article-card { --card-accent: var(--color-lehm); background: var(--color-surface-raised); border: 1px solid var(--color-border); display: flex; flex-direction: column; height: 100%; }
  .article-card--salbei { --card-accent: var(--color-salbei); }
  .article-card--sonne { --card-accent: var(--color-sonne); }
  .article-card--mauve { --card-accent: var(--color-mauve); }
  .article-card__image { aspect-ratio: 1.25; display: block; isolation: isolate; overflow: hidden; position: relative; }
  .article-card__image :global(picture), .article-card__image :global(img) { height: 100%; position: relative; width: 100%; z-index: 0; }
  .article-card__image :global(img) { object-fit: cover; transition: transform 320ms ease; }
  .article-card:hover .article-card__image :global(img) { transform: scale(1.03); }
  .article-card__image--placeholder { align-items: center; background: var(--color-surface-muted); display: flex; justify-content: center; text-decoration: none; }
  .article-card__placeholder { align-items: center; color: var(--color-olive-ink); display: flex; flex-direction: column; font-size: var(--text-xs); font-weight: var(--font-weight-bold); gap: var(--space-3); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .article-card__body { align-items: flex-start; display: flex; flex: 1; flex-direction: column; padding: var(--space-6); }
  .article-card__meta { background: var(--card-accent); color: var(--color-espresso); font-size: var(--text-xs); font-weight: 700; left: 0; letter-spacing: var(--tracking-caps); padding: var(--space-2) var(--space-3); position: absolute; text-transform: uppercase; top: 0; z-index: var(--z-overlay); }
  h3 { font-size: var(--text-card-title); hyphens: auto; line-height: var(--leading-card-title); margin-top: var(--space-2); overflow-wrap: break-word; text-wrap: balance; width: 100%; }
  h3 a { display: -webkit-box; overflow: hidden; text-decoration: none; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .article-card__excerpt { font-size: var(--text-base); margin-top: var(--space-4); text-wrap: pretty; }
  .article-card__details { margin-top: var(--space-5); width: 100%; }
  .article-card--featured { border: 0; }

  @media (min-width: 768px) {
    .article-card__excerpt { display: -webkit-box; min-block-size: calc(4em * var(--leading-normal)); overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
  }
</style>
