---
import Icon from "./Icon.astro";

interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "text";
  icon?: boolean;
  external?: boolean;
  class?: string;
  ariaLabel?: string;
  id?: string;
  ariaPressed?: boolean;
}

const { href, type = "button", variant = "primary", icon = false, class: className, external = false, ariaLabel, id, ariaPressed } = Astro.props;
const classes = `button button--${variant} ${className ?? ""}`;
---

{href ? (
  <a class={classes} href={href} aria-label={ariaLabel} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
    <slot />
    {icon && <Icon name="arrow-right" size={16} />}
  </a>
) : (
  <button class={classes} type={type} aria-label={ariaLabel} aria-pressed={ariaPressed} id={id}>
    <slot />
    {icon && <Icon name="arrow-right" size={16} />}
  </button>
)}

<style>
  .button {
    align-items: center;
    border: 1px solid transparent;
    display: inline-flex;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    gap: var(--space-2);
    justify-content: center;
    letter-spacing: var(--tracking-caps);
    min-height: var(--control-height);
    padding: 0.7rem 1.15rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: background var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }
  .button--primary { background: var(--color-action); color: var(--color-on-action); }
  .button--primary:hover { background: var(--color-action-hover); }
  .button--secondary { border-color: var(--color-action); color: var(--color-action); }
  .button--secondary:hover { background: var(--color-action); color: var(--color-on-action); }
  .button--text { color: var(--color-action); min-height: auto; padding: 0; }
  .button--text:hover { color: var(--color-action-hover); }
</style>
