---
interface PageItem {
  label: string;
  href?: string;
  current?: boolean;
  disabled?: boolean;
}

interface Props {
  items: PageItem[];
  label?: string;
}

const { items, label = "Seitennavigation" } = Astro.props;
---

<nav class="pagination" aria-label={label}>
  <ul>
    {items.map((item) => (
      <li>
        {item.href && !item.disabled ? (
          <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>
        ) : (
          <span aria-current={item.current ? "page" : undefined} aria-disabled={item.disabled ? "true" : undefined}>{item.label}</span>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  ul { align-items: center; display: flex; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  a, span { align-items: center; color: var(--color-text); display: inline-flex; font-size: var(--text-sm); justify-content: center; min-height: 2.25rem; min-width: 2.25rem; padding: var(--space-1) var(--space-2); text-decoration: none; }
  a:hover { color: var(--color-terracotta); }
  [aria-current="page"] { border: 1px solid var(--color-terracotta); color: var(--color-terracotta); }
  [aria-disabled="true"] { color: var(--color-text-muted); opacity: 0.55; }
</style>
