---
import Icon from "../ui/Icon.astro";

const navigation = [
  { label: "Journal", href: "/journal" },
  { label: "Genuss", href: "/genuss" },
  { label: "Über Domaće", href: "/willkommen" },
];

interface Props { activePath?: string; }
const { activePath } = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Domaće – Startseite">
      <img class="brand__wordmark" src="/images/wordmark_domace.png" alt="Domaće" width="1354" height="275" />
      <span class="brand__tagline">Von Zuhause. Für Zuhause.</span>
    </a>
    <nav class="site-nav" id="primary-navigation" data-open="false" aria-label="Hauptnavigation">
      <ul>
        {navigation.map((item) => (
          <li><a class:list={{ "is-active": item.href === activePath }} href={item.href} aria-current={item.href === activePath ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Menü öffnen">
        <span class="menu-toggle__open"><Icon name="menu" size={22} /></span>
        <span class="menu-toggle__close"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = header?.querySelector<HTMLElement>(".site-nav");

  if (header && toggle && navigation) {
    header.dataset.menuReady = "true";

    const closeMenu = (restoreFocus = false) => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Menü öffnen");
      navigation.dataset.open = "false";
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      const willOpen = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(willOpen));
      toggle.setAttribute("aria-label", willOpen ? "Menü schließen" : "Menü öffnen");
      navigation.dataset.open = String(willOpen);
    });

    navigation.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => closeMenu()));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") closeMenu(true);
    });
  }
</script>

<style>
  .site-header { background: var(--color-surface); border-bottom: var(--divider-thickness) solid var(--color-divider); }
  .site-header__inner { align-items: center; display: grid; gap: var(--space-6); grid-template-columns: auto minmax(0, 1fr) auto; margin: 0 auto; max-width: var(--content-width); min-height: 7rem; padding: var(--space-4) var(--page-gutter); }
  .brand { color: var(--color-espresso); display: inline-flex; flex-direction: column; text-decoration: none; width: fit-content; }
  .brand__wordmark { display: block; height: auto; max-width: clamp(8rem, 10vw, 10rem); width: 100%; }
  .brand__tagline { font-family: var(--font-script); font-size: var(--text-sm); margin-top: var(--space-2); white-space: nowrap; }
  .site-nav { justify-self: end; }
  .site-nav ul { display: flex; gap: clamp(var(--space-4), 2.1vw, var(--space-8)); list-style: none; margin: 0; padding: 0; }
  .site-nav a { color: var(--color-text); display: block; font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; padding: var(--space-3) 0; position: relative; text-decoration: none; text-transform: uppercase; }
  .site-nav a::after { background: var(--color-terracotta); bottom: 0; content: ""; height: 2px; left: 0; position: absolute; transform: scaleX(0); transform-origin: left; transition: transform var(--transition-base); width: 100%; }
  .site-nav a:hover::after, .site-nav a.is-active::after { transform: scaleX(1); }
  .site-nav a.is-active { color: var(--color-terracotta); }
  .site-header__actions { align-items: center; display: flex; gap: var(--space-2); justify-self: end; }
  .menu-toggle { align-items: center; background: transparent; border: 0; color: var(--color-text); cursor: pointer; display: none; justify-content: center; min-height: var(--space-12); min-width: var(--space-12); padding: 0; }
  .menu-toggle__close { display: none; }
  .menu-toggle[aria-expanded="true"] .menu-toggle__open { display: none; }
  .menu-toggle[aria-expanded="true"] .menu-toggle__close { display: inline-flex; }
  .menu-toggle:hover { color: var(--color-terracotta); }
  .menu-toggle:focus-visible, .site-nav a:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-offset); }

  @media (max-width: 60rem) {
    .site-header__inner { gap: var(--space-3); grid-template-columns: minmax(0, 1fr) auto; min-height: auto; }
    .site-header__actions { grid-column: 2; grid-row: 1; }
    .menu-toggle { display: inline-flex; }
    .site-nav { background: var(--color-surface); grid-column: 1 / -1; grid-row: 2; justify-self: stretch; width: 100%; }
    .site-nav[data-open="false"] { display: none; }
    .site-nav ul { display: grid; gap: 0; width: 100%; }
    .site-nav li + li { border-top: var(--divider-thickness) solid var(--color-divider); }
    .site-nav a { padding: var(--space-4) 0; }
  }

  @media (max-width: 34rem) {
    .brand__tagline { font-size: 0.68rem; }
  }
</style>