---
import Button from "../ui/Button.astro";
import Divider from "../ui/Divider.astro";
import Icon from "../ui/Icon.astro";
import OptimizedImage from "../ui/OptimizedImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image: ImageMetadata;
  imageAlt?: string;
  cta?: { label: string; href: string };
  accent?: "terracotta" | "olive";
  badge?: string;
  variant?: "default" | "homepage";
  showTitleIcon?: boolean;
  narrowContent?: boolean;
}

const { eyebrow, title, description, image, imageAlt = "", cta, accent = "terracotta", badge, variant = "default", showTitleIcon = true, narrowContent = false } = Astro.props;
const hasDescriptionSlot = Astro.slots.has("description");
---

<section class:list={["editorial-hero", `editorial-hero--${accent}`, `editorial-hero--${variant}`, { "editorial-hero--narrow-content": narrowContent }]}>
  <div class="editorial-hero__content">
    {eyebrow && <p class="editorial-hero__eyebrow">{eyebrow}</p>}
    <h1>{title}{showTitleIcon && <> <Icon name="heart" size={30} /></>}</h1>
    <div class="editorial-hero__rule"><Divider tone={accent === "olive" ? "olive" : "terracotta"} /></div>
    {hasDescriptionSlot ? (
      <div class="editorial-hero__description"><slot name="description" /></div>
    ) : description && (
      <p class="editorial-hero__description">{description}</p>
    )}
    {cta && <Button href={cta.href}>{cta.label}</Button>}
  </div>
  <div class="editorial-hero__media">
    <OptimizedImage
      src={image}
      alt={imageAlt}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes={variant === "homepage" ? "(max-width: 1280px) 100vw, 1280px" : "(max-width: 700px) 100vw, 50vw"}
      loading="eager"
      fetchpriority="high"
    />
    {badge && <span class="editorial-hero__badge">{badge}</span>}
  </div>
</section>

<style>
  .editorial-hero { background: var(--color-surface-muted); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: min(37rem, 65vw); }
  .editorial-hero__content { align-self: center; max-width: 40rem; padding: clamp(var(--space-8), 8vw, var(--space-24)); padding-right: clamp(var(--space-6), 6vw, var(--space-16)); }
  .editorial-hero__eyebrow { color: var(--color-terracotta); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  h1 { font-size: var(--text-3xl); margin-top: var(--space-4); }
  h1 :global(svg) { color: var(--color-terracotta); display: inline-block; margin-left: var(--space-2); vertical-align: 0.08em; }
  .editorial-hero__rule { margin: var(--space-6) 0; }
  .editorial-hero__description { font-size: var(--text-lg); max-width: 31rem; white-space: pre-line; }
  .editorial-hero__description :global(p + p) { margin-top: var(--space-4); }
  .editorial-hero__description + :global(.button) { margin-top: var(--space-6); }
  .editorial-hero__media { min-height: 100%; position: relative; }
  .editorial-hero__media :global(picture), .editorial-hero__media :global(img) { height: 100%; width: 100%; }
  .editorial-hero__media :global(img) { object-fit: cover; }
  .editorial-hero__badge { align-items: center; aspect-ratio: 1; background: var(--color-pflaume); border-radius: 50%; color: var(--color-kalk); display: flex; font-size: var(--text-xs); font-weight: 700; justify-content: center; letter-spacing: var(--tracking-caps); padding: var(--space-4); position: absolute; right: var(--space-6); text-align: center; text-transform: uppercase; top: var(--space-6); width: 7rem; }
  .editorial-hero--olive .editorial-hero__eyebrow, .editorial-hero--olive h1 :global(svg) { color: var(--color-olive-dark); }
  /* Homepage: a single image, softly faded into the text area on the left. */
  .editorial-hero--homepage { display: block; isolation: isolate; min-height: clamp(31rem, 43vw, 35rem); overflow: hidden; position: relative; width: 100%; }
  .editorial-hero--homepage::after { background: linear-gradient(90deg, var(--color-surface-muted) 0%, rgb(241 233 224 / 97%) 27%, rgb(241 233 224 / 72%) 47%, rgb(241 233 224 / 0%) 67%); content: ""; inset: 0; pointer-events: none; position: absolute; z-index: 1; }
  .editorial-hero--homepage .editorial-hero__content { max-width: none; padding: clamp(2.5rem, 5vw, 4.5rem); padding-left: max(var(--page-gutter), calc((100vw - var(--content-width)) / 2 + var(--page-gutter))); position: relative; width: 60%; z-index: 2; }
  .editorial-hero--homepage.editorial-hero--narrow-content .editorial-hero__content { width: 52%; }
  .editorial-hero--narrow-content .editorial-hero__description { max-width: calc(var(--content-narrow) - var(--space-24)); }
  .editorial-hero--homepage h1 { font-size: var(--text-home-heading); white-space: pre-line; }
  .editorial-hero--homepage .editorial-hero__media { inset: 0; position: absolute; z-index: 0; }
  .editorial-hero--homepage .editorial-hero__media :global(img) { object-position: right center; }

  @media (max-width: 64rem) {
    .editorial-hero--homepage { min-height: 31rem; }
  }

  @media (max-width: 44rem) { .editorial-hero { grid-template-columns: 1fr; } .editorial-hero__content { padding: var(--space-12) var(--page-gutter); } .editorial-hero__media { min-height: 19rem; } }

  @media (max-width: 34rem) {
    .editorial-hero--homepage { min-height: 34rem; }
    .editorial-hero--homepage::after { background: linear-gradient(90deg, var(--color-surface-muted) 0%, rgb(241 233 224 / 94%) 55%, rgb(241 233 224 / 43%) 100%); }
    .editorial-hero--homepage .editorial-hero__content { max-width: 21rem; padding: var(--space-10) var(--page-gutter); width: 78%; }
  }
</style>
