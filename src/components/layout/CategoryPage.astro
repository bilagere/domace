---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialHero from "./EditorialHero.astro";
import ArticleCard from "../ui/ArticleCard.astro";
import Button from "../ui/Button.astro";
import MediaText from "../ui/MediaText.astro";
import NewsletterSignup from "../ui/NewsletterSignup.astro";
import PageSection from "../ui/PageSection.astro";
import QuoteBanner from "../ui/QuoteBanner.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import newsletterImage from "../../assets/images/newsletter-feature.png";
import type { CategoryPageData } from "../../data/categories";

interface Props {
  data: CategoryPageData;
}

const { data } = Astro.props;
---

<BaseLayout
  title={data.pageTitle}
  description={data.description}
  activePath="/journal"
  footerGallery={[data.heroImage, data.quoteImage, newsletterImage]}
>
  <div class="category-hero">
    <EditorialHero
      variant="homepage"
      narrowContent
      showTitleIcon={false}
      eyebrow={data.eyebrow}
      title={data.heroTitle}
      description={data.heroDescription}
      image={data.heroImage}
      imageAlt={data.heroAlt}
    />
  </div>

  {data.articles.length > 0 && (
    <PageSection labelledBy="category-posts-heading" class="category-posts">
      <div class="category-posts__heading">
        <SectionHeading id="category-posts-heading" eyebrow="Neu im Journal">Aus {data.title}.</SectionHeading>
        <Button href="/journal" variant="text" icon>Alle Beiträge ansehen</Button>
      </div>
      <div class="category-posts__grid" id="beitraege">
        {data.articles.map((article) => <ArticleCard {...article} />)}
      </div>
    </PageSection>
  )}

  <section class="category-quote" aria-label="Leitsatz">
    <QuoteBanner
      image={data.quoteImage}
      imageAlt={data.quoteAlt}
      tone="plum"
    >
      {data.quote}
    </QuoteBanner>
  </section>

  <section class="category-newsletter" aria-label="Newsletter">
    <MediaText image={newsletterImage} imageAlt="Kaffeetasse auf einem hellen Holztisch" ratio="media-40" variant="newsletter">
      <NewsletterSignup
        compact
        eyebrow="Post für dich"
        title="Schönes für deinen Alltag."
        description={`Neue Gedanken, Ideen und Beiträge aus ${data.title} direkt in dein Postfach.`}
      />
    </MediaText>
  </section>
</BaseLayout>

<style>
  .category-hero :global(.editorial-hero--homepage) { min-height: clamp(21rem, 31vw, 25rem); }
  .category-hero :global(.editorial-hero--homepage .editorial-hero__content) { padding-block: clamp(var(--space-8), 4vw, var(--space-12)); }
  .category-hero :global(.editorial-hero--homepage h1) { font-size: clamp(2.4rem, 4vw, 4rem); }
  .category-hero :global(.editorial-hero__description) { font-size: var(--text-base); line-height: var(--leading-relaxed); }
  .category-posts__heading { align-items: end; display: flex; gap: var(--space-6); justify-content: space-between; }
  .category-posts__grid { display: grid; gap: var(--space-6); grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--space-8); scroll-margin-top: var(--space-6); }
  .category-quote, .category-newsletter { margin-top: var(--space-12); }
  @media (max-width: 48rem) {
    .category-posts__heading { align-items: flex-start; flex-direction: column; }
    .category-posts__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 34rem) {
    .category-hero :global(.editorial-hero--homepage) { min-height: 26rem; }
    .category-hero :global(.editorial-hero--homepage .editorial-hero__content) { width: 82%; }
  }
</style>

