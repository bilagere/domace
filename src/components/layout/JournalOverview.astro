---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialHero from "./EditorialHero.astro";
import FilterableCardGrid from "../ui/FilterableCardGrid.astro";
import MediaText from "../ui/MediaText.astro";
import NewsletterSignup from "../ui/NewsletterSignup.astro";
import PageSection from "../ui/PageSection.astro";
import QuoteBanner from "../ui/QuoteBanner.astro";
import { journalPreviews } from "../../data/relatedContent";
import { journalCategories, type JournalCategory } from "../../data/taxonomy";
import heroJournal from "../../assets/images/hero-journal.png";
import newsletter from "../../assets/images/newsletter-journal.png";
import quote from "../../assets/images/quote_journal.png";

export type { JournalCategory } from "../../data/taxonomy";
interface Props { activeCategory?: JournalCategory; }
const { activeCategory } = Astro.props;
const activeTag = journalCategories.find((tag) => tag.category === activeCategory);
---

<BaseLayout
  title={activeTag?.pageTitle ?? "Journal – Domaće"}
  description="Gedanken, Routinen und Inspiration für ein ruhigeres, verbundenes Familienleben."
  activePath="/journal"
>
  <PageSection label="Journalbeiträge" spacing="compact">
    <FilterableCardGrid
      items={journalPreviews}
      categories={journalCategories}
      activeCategory={activeCategory}
      allHref="/journal"
      allPageTitle="Journal – Domaće"
      emptyMessage="In diesem Bereich folgen bald die ersten Beiträge."
      paginationLabel="Journalseiten"
      previousLabel="Vorherige Journalseite"
      nextLabel="Nächste Journalseite"
    />
  </PageSection>

  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    eyebrow="Gedanken vom Küchentisch"
    title="Was braucht deine Familie gerade wirklich?"
    image={heroJournal}
    imageAlt="Ein heller Tisch am Fenster in ruhiger Atmosphäre"
  >
    <Fragment slot="description">
      <p>Nicht jede Antwort passt zu jeder Familie. Hier findest du Gedanken, kleine Routinen und praktische Ideen, die dir helfen sollen, euren eigenen Weg zu finden. Nimm einfach das mit, was gerade zu euch passt.</p>
    </Fragment>
  </EditorialHero>

  <section class="quote-feature" aria-label="Leitsatz">
    <QuoteBanner image={quote} imageAlt="Warmes Zuhause in natürlichen Tönen">
      Manche Gedanken brauchen keinen Rat.<br />Nur einen Ort, an dem sie bleiben dürfen.
    </QuoteBanner>
  </section>

  <section class="newsletter-feature" aria-label="Newsletter">
    <MediaText image={newsletter} imageAlt="Kaffeetasse auf einem hellen Holztisch" ratio="media-40" variant="newsletter">
      <NewsletterSignup compact eyebrow="Zwischen den Zeilen." title="Worte, die gut tun." description="Neue Geschichten, ehrliche Gedanken und Inspiration für ein Familienleben, das sich nach Zuhause anfühlt." />
    </MediaText>
  </section>
</BaseLayout>

<style>
  .quote-feature, .newsletter-feature { margin-top: var(--space-12); }
</style>
