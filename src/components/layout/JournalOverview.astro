---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialHero from "./EditorialHero.astro";
import FilterableCardGrid from "../ui/FilterableCardGrid.astro";
import MediaText from "../ui/MediaText.astro";
import NewsletterSignup from "../ui/NewsletterSignup.astro";
import PageSection from "../ui/PageSection.astro";
import QuoteBanner from "../ui/QuoteBanner.astro";
import { journalPreviews } from "../../data/relatedContent";
import { journalCategories, type JournalCategory } from "../../data/taxonomy";
import heroJournal from "../../assets/images/hero-journal.png";
import newsletter from "../../assets/images/newsletter-journal.png";
import quote from "../../assets/images/quote_journal.png";

export type { JournalCategory } from "../../data/taxonomy";
interface Props { activeCategory?: JournalCategory; }
const { activeCategory } = Astro.props;
const activeTag = journalCategories.find((tag) => tag.category === activeCategory);
---

<BaseLayout
  lang="en"
  title={activeTag?.pageTitle ?? "Journal – Domaće"}
  description="Notes on home, family and everyday life. Practical ideas, familiar rituals and things I’m learning along the way."
  activePath="/journal"
>
  <PageSection label="Journal stories" spacing="compact">
    <FilterableCardGrid
      items={journalPreviews}
      categories={journalCategories}
      activeCategory={activeCategory}
      allHref="/journal"
      allLabel="All stories"
      allPageTitle="Journal – Domaće"
      emptyMessage="There are no stories here just yet. In the meantime, make yourself at home in the rest of the journal."
      paginationLabel="Journal pages"
      previousLabel="Previous"
      nextLabel="Next"
    />
  </PageSection>

  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    eyebrow="NOTES FROM THE KITCHEN TABLE"
    title="For the life you’re actually living."
    image={heroJournal}
    imageAlt="A woman working at a laptop with a cup of coffee at her kitchen table"
  >
    <Fragment slot="description">
      <p>Family life rarely comes with one right answer. This is where I share what I’m learning along the way — thoughts on home and family, rhythms that work for us, and practical ideas worth passing on.</p>
      <p><strong>Take what works. Leave what doesn’t.</strong></p>
    </Fragment>
  </EditorialHero>

  <section class="quote-feature" aria-label="A thought to share">
    <QuoteBanner image={quote} imageAlt="A warm home in natural tones">
      Some thoughts are meant<br />to be shared, not solved.
    </QuoteBanner>
  </section>

  <section class="newsletter-feature" aria-label="Newsletter">
    <MediaText image={newsletter} imageAlt="A coffee cup on a light wooden table" ratio="media-40" variant="newsletter">
      <NewsletterSignup compact />
    </MediaText>
  </section>
</BaseLayout>

<style>
  .quote-feature, .newsletter-feature { margin-top: var(--space-12); }
</style>
