---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialHero from "./EditorialHero.astro";
import FilterableCardGrid from "../ui/FilterableCardGrid.astro";
import MediaText from "../ui/MediaText.astro";
import NewsletterSignup from "../ui/NewsletterSignup.astro";
import PageSection from "../ui/PageSection.astro";
import QuoteBanner from "../ui/QuoteBanner.astro";
import { recipePreviews } from "../../data/relatedContent";
import { recipeCategories, type RecipeCategory } from "../../data/taxonomy";
import heroEnjoy from "../../assets/images/hero-geniessen.png";
import newsletter from "../../assets/images/newsletter-geniessen.png";
import quote from "../../assets/images/quote-geniessen.png";

export type { RecipeCategory } from "../../data/taxonomy";
interface Props { activeCategory?: RecipeCategory; }
const { activeCategory } = Astro.props;
const activeTag = recipeCategories.find((tag) => tag.category === activeCategory);
---

<BaseLayout
  lang="en"
  title={activeTag?.pageTitle ?? "Kitchen – Domaće"}
  description="Family favorites, Croatian recipes, Alpine comfort food and everyday cooking. Good food made for sharing."
  activePath="/kitchen"
>
  <PageSection label="Recipes" spacing="compact">
    <FilterableCardGrid
      items={recipePreviews}
      categories={recipeCategories}
      activeCategory={activeCategory}
      allHref="/kitchen"
      allLabel="All recipes"
      allPageTitle="Kitchen – Domaće"
      emptyMessage="Something good is on its way. Explore the other recipes while you’re here."
      paginationLabel="Recipe pages"
      previousLabel="Previous"
      nextLabel="Next"
    />
  </PageSection>

  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    eyebrow="FROM MY KITCHEN"
    title="Come and see what’s cooking."
    image={heroEnjoy}
    imageAlt="Freshly prepared food on a warmly set table"
  >
    <Fragment slot="description">
      <p>Family favorites, recipes from my Croatian roots, Alpine comfort food, bread from the oven and plenty of everyday cooking. Nothing too precious. Just good food made for sharing.</p>
      <p><strong>Pull up a chair.</strong></p>
    </Fragment>
  </EditorialHero>

  <section class="quote-feature" aria-label="A thought to share">
    <QuoteBanner image={quote} imageAlt="Freshly baked bread in a warm, natural setting">
      The food we grow up with<br />stays with us for life.
    </QuoteBanner>
  </section>

  <section class="newsletter-feature" aria-label="Newsletter">
    <MediaText image={newsletter} imageAlt="A warm welcome from the Domaće kitchen" ratio="media-40" variant="newsletter">
      <NewsletterSignup compact />
    </MediaText>
  </section>
</BaseLayout>

<style>
  .quote-feature, .newsletter-feature { margin-top: var(--space-12); }
</style>
