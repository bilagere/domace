---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/layout/EditorialHero.astro";
import ArticleCard from "../components/ui/ArticleCard.astro";
import Button from "../components/ui/Button.astro";
import MediaText from "../components/ui/MediaText.astro";
import NewsletterSignup from "../components/ui/NewsletterSignup.astro";
import QuoteBanner from "../components/ui/QuoteBanner.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TopicCard from "../components/ui/TopicCard.astro";
import { journalCategories } from "../data/taxonomy";
import { latestContent } from "../data/relatedContent";
import hero from "../assets/images/hero_homepage.png";
import together from "../assets/images/together.png";
import enjoy from "../assets/images/enjoy.png";
import arrive from "../assets/images/ankommen_homepage.png";
import organize from "../assets/images/organize.png";
import newsletter from "../assets/images/newsletter-feature.png";
import author from "../assets/images/Mara_Lukic.png";
import quote from "../assets/images/quote-home.png";

const images = {
  hero,
  together,
  enjoy,
  arrive,
  organize,
  newsletter,
  author,
  quote,
};

const topicDetails = {
  home: { subtitle: "For a home that feels lived in.", description: "All about the home, garden, small projects and the everyday work of making a house a home.", linkLabel: "Explore Home", icon: "leaf" as const, image: images.arrive, tone: "salbei" as const },
  kitchen: { subtitle: "Food made for sharing.", description: "Family cooking, bread, seasonal food and the joy of gathering around a meal.", linkLabel: "Come to the Kitchen", icon: "cooking-pot" as const, image: images.enjoy, tone: "lehm" as const },
  rhythm: { subtitle: "A little more ease, every day.", description: "Meal planning, ingredient prep and gentle routines that help our days run a little smoother.", linkLabel: "Find your rhythm", icon: "list-check" as const, image: images.organize, tone: "sonne" as const },
  family: { subtitle: "The moments we share.", description: "Motherhood, relationships, rituals and traditions that bring us together.", linkLabel: "Explore Family", icon: "users" as const, image: images.together, tone: "mauve" as const },
};
const topics = journalCategories.map(({ category, label, href }) => ({
  ...topicDetails[category], title: label, href, imageLinkLabel: `Explore ${label}`,
}));

---

<BaseLayout
  lang="en"
  title="Domaće | European homemaking"
  description="European homemaking, family food and ordinary moments worth remembering. Welcome to Domaće."
  socialTitle="Domaće | European homemaking"
  socialDescription="European homemaking, family food and ordinary moments worth remembering. Welcome to Domaće."
  socialImageAlt="Domaće · European homemaking"
  footerGallery={[images.arrive, images.newsletter, images.enjoy]}
>
  <section class="section latest-section" id="neu" aria-labelledby="newest-heading">
    <div class="section__heading-row">
      <SectionHeading as="h1" id="newest-heading">Come in. Stay a while.</SectionHeading>
      <Button href="/journal" variant="text" icon>All stories</Button>
    </div>
    <div class="article-grid">
      {latestContent.map((post) => <ArticleCard {...post} />)}
    </div>
  </section>

  <div class="homepage-hero">
    <EditorialHero variant="homepage" showTitleIcon={false}
      eyebrow="CROATIAN ROOTS · AUSTRIAN ALPS"
      title={"A slower\nkind of family life."}

      image={images.hero}
      imageAlt="Wildflowers in a ceramic vase and a bowl of fruit on a wooden kitchen table"
      headingAs="h2"
    >
      <Fragment slot="description">
        <p>I don't want to rush through these years.</p>
        <p>So much of family life happens in ordinary moments: breakfast at the kitchen table, little hands helping with dinner, a walk through town, people gathering around food.</p>
        <p>Domaće is my way of paying attention to them.</p>
      </Fragment>
    </EditorialHero>
  </div>

  <section class="section topic-section" aria-label="Domaće topics">
    <div class="topic-grid">
      {topics.map((topic) => <TopicCard {...topic} />)}
    </div>
  </section>

  <section class="newsletter-feature" aria-label="Newsletter">
    <MediaText image={images.newsletter} imageAlt="A coffee cup on a light wooden table" ratio="media-40" variant="newsletter">
      <NewsletterSignup compact eyebrow="LETTERS FROM HOME" title="A little note from my kitchen table." description="Recipes, seasonal ideas and small things that make family life feel a little easier. From our home to your inbox." />
    </MediaText>
  </section>

  <section class="quote-feature" aria-label="Our philosophy">
    <QuoteBanner image={images.quote} imageAlt="A warm home in soft plum and earthy tones">
      A lived-in home<br />
      is rarely a perfect one.<br />
      And maybe that’s<br />
      exactly the point.
    </QuoteBanner>
  </section>

  <section class="author-section">
    <MediaText image={images.author} imageAlt="Portrait of Mara holding a cup" reverse>
      <SectionHeading eyebrow="WELCOME TO DOMAĆE">My name is Mara.</SectionHeading>
      <div class="author-section__copy">
        <p>I’m a mother of two, a homemaker, an enthusiastic home cook and gardener — and usually in the middle of making, growing or planning something.</p>
        <p>My family and I live in a small town in the Austrian Alps, but Croatia has always been part of my identity and what home means to me. It shows in the way I feed my family, gather loved ones around the table and share traditions with my children.</p>
        <p>Domaće grew out of all of that. It’s a place for the recipes I want to remember, the things I’m learning about keeping a home, and bits and pieces of our life along the way.</p>
      </div>
      <Button href="/about" icon>More about me</Button>
    </MediaText>
  </section>
</BaseLayout>

<style>
  .section { margin-inline: auto; max-width: var(--content-width); padding: var(--space-20) var(--page-gutter); }
  .latest-section { max-width: calc(var(--content-width) + (var(--space-16) * 2)); }
  .topic-section, .latest-section { padding-block: 0; }
  .topic-section, .latest-section, .homepage-hero, .newsletter-feature, .quote-feature, .author-section { margin-top: var(--space-12); }
  .topic-grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .section__heading-row { align-items: end; display: flex; justify-content: space-between; margin-bottom: var(--space-8); }
  .article-grid { display: grid; gap: var(--space-6); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  :global(.site-footer) { margin-top: var(--space-12); }
  .author-section__copy { font-size: var(--text-lg); margin: var(--space-6) 0; max-width: 36rem; }
  .author-section__copy p + p { margin-top: var(--space-4); }
  @media (max-width: 64rem) { .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 64rem) { .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 46rem) { .article-grid { grid-template-columns: 1fr; } .section__heading-row { align-items: flex-start; flex-direction: column; gap: var(--space-4); } }
  @media (max-width: 34rem) { .topic-grid { grid-template-columns: 1fr; } }
</style>
