---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/ui/PageIntro.astro";
import PageSection from "../components/ui/PageSection.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  lang="en"
  title="Page not found – Domaće"
  description="This page couldn’t be found. Head home to explore Domaće."
  noindex
>
  <PageIntro
    eyebrow="404 · PAGE NOT FOUND"
    title="Head home."
    description="This page couldn’t be found. It may have moved, or the link might be out of date."
    align="center"
  />
  <PageSection width="narrow" spacing="generous">
    <div class="not-found">
      <p>There’s still plenty to discover.</p>
      <Button href="/" icon>BACK TO HOME</Button>
    </div>
  </PageSection>
</BaseLayout>

<style>
  .not-found { text-align: center; }
  .not-found p { color: var(--color-text-muted); font-size: var(--text-lg); margin-bottom: var(--space-6); }
</style>
