---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import EditorialHero from "../components/layout/EditorialHero.astro";
import Icon from "../components/ui/Icon.astro";
import OptimizedImage from "../components/ui/OptimizedImage.astro";
import MediaText from "../components/ui/MediaText.astro";
import NewsletterSignup from "../components/ui/NewsletterSignup.astro";
import QuoteBanner from "../components/ui/QuoteBanner.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import author from "../assets/images/autorin-mara.png";
import heroAbout from "../assets/images/hero-about.png";
import tableAtWindow from "../assets/images/tisch-am-fenster.png";
import newsletter from "../assets/images/newsletter-feature.png";
import quote from "../assets/images/quote-about.png";

const values = [
  { icon: "heart-handshake" as const, label: "Ehrliche Gedanken" },
  { icon: "salad" as const, label: "Einfache Rezepte" },
  { icon: "sparkles" as const, label: "Praktische Ideen" },
  { icon: "party-popper" as const, label: "Kleine Rituale" },
  { icon: "users" as const, label: "Ein gutes Familienleben" },
];

const facts = [
  "Mama von zwei wunderbaren Mädchen",
  "Backe fast täglich Brot oder Gebäck",
  "Kaffee in der Hand, Baby auf der Hüfte, Ideen im Kopf",
  "Ein Spaziergang im Wald löst mehr Probleme als eine Stunde am Handy.",
  "Liebhaberin von geordneten Schubladen und vollen Blumentöpfen",
  "Plane gerne, lasse aber auch Raum für Spontanes",
  "Am glücklichsten bin ich, wenn alle gemeinsam am Tisch sitzen und es nach frisch gekochtem Essen duftet.",
  "Ein voller Vorratsschrank gibt mir mehr Ruhe als ein voller Kleiderschrank.",
  "Ich freue mich über Gäste, die länger bleiben als geplant.",
];
---

<BaseLayout
  title="Willkommen bei Domaće"
  description="Die Geschichte hinter Domaće und der Mensch, der diesen Ort mit Leben füllt."
  activePath="/willkommen"
>
  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    narrowContent
    eyebrow="Herzlich Willkommen"
    title={`Die Geschichte
hinter Domaće`}
    image={heroAbout}
    imageAlt="Ein warmer Einblick in Maras Zuhause"
  >
    <Fragment slot="description">
      <p>Domaće ist ein Ort für alle, die das gute Familienleben lieben. Der Name Domaće steht für etwas Hausgemachtes, Vertrautes und Nahes.</p>
      <p>Genau dieses Gefühl soll auch diese Seite vermitteln: Du darfst stöbern, etwas ausprobieren und nur das mitnehmen, was zu dir und deiner Familie passt.</p>
    </Fragment>
  </EditorialHero>

  <Container>
    <section class="story-section" aria-labelledby="story-title">
      <div class="story-section__media">
        <OptimizedImage src={tableAtWindow} alt="Gedeckter Holztisch an einem hellen Fenster" widths={[480, 720, 960]} sizes="(max-width: 704px) 100vw, 36vw" />
      </div>
      <div class="story-section__copy">
        <SectionHeading eyebrow="Warum es Domaće gibt" id="story-title">Aus dem echten Leben.</SectionHeading>
        <p>Zwischen Menüplanung, Wäschebergen und großen Krokodilstränen habe ich oft nach einem Ort gesucht, der mich zum einen motiviert und mir gleichzeitig das Gefühl gibt: Ich bin nicht allein.</p>
        <p>Ich wollte Tipps, die wirklich funktionieren. Rezepte, die nach Zuhause schmecken. Gedanken, die mir den Kopf freimachen und Inspiration für ein Familienleben, das sich gut anfühlt und nicht den Anspruch hat perfekt auszusehen.</p>
        <p>Also habe ich angefangen, all das zu sammeln, auszuprobieren und weiterzugeben. Domaće ist das Ergebnis und eine Einladung an dich, dein Leben bewusster zu gestalten.</p>
        <ul class="value-list">
          {values.map((value) => (
            <li><Icon name={value.icon} size={28} /><span>{value.label}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="author-story" aria-labelledby="author-title">
      <div class="author-story__copy">
        <SectionHeading eyebrow="Über die Autorin" id="author-title">Ich bin Mara.</SectionHeading>
        <p>Auf Domaće schreibe ich, Mara Lukić – Mama von zwei Mädchen, Ehefrau, Hausfrau, Genussmensch und noch vieles mehr.</p>
        <p>Ich weiß, dass Mütter täglich Unglaubliches leisten – auch wenn vieles davon unsichtbar bleibt. Ich glaube, dass weniger mentale Last zu besseren Entscheidungen, mehr Struktur und gegenseitiger Unterstützung führt und dadurch Raum für das entsteht, was im Leben wirklich zählt: Nähe, Leichtigkeit und gemeinsame Erinnerungen.</p>
        <p>Hier teile ich, was uns guttut, was wir lieben und was unseren Alltag leichter macht.</p>
        <p>Oft sind es die kleinen, wiederkehrenden Dinge, die Halt geben: ein Essen, das allen schmeckt, ein Zuhause, in dem man ankommen kann, oder eine Routine, die den Kopf ein wenig freier macht.</p>
        <p class="signature">Alles Liebe, Mara Lukić</p>
      </div>
      <div class="author-story__media">
        <OptimizedImage src={author} alt="Porträt von Mara mit einer Tasse" widths={[480, 720, 960]} sizes="(max-width: 704px) 100vw, 56vw" />
        <aside class="facts-card" aria-label="Ein paar Fakten über Mara">
          <p class="eyebrow">Ein paar Fakten über mich</p>
          <ul>{facts.map((fact) => <li><Icon name="heart" size={14} /><span>{fact}</span></li>)}</ul>
        </aside>
      </div>
    </section>
  </Container>

  <section class="newsletter-feature" aria-label="Newsletter">
    <MediaText image={newsletter} imageAlt="Kaffeetasse auf einem hellen Holztisch" ratio="media-40" variant="newsletter">
      <NewsletterSignup compact title="Lass uns in Verbindung bleiben." description="Erhalte regelmäßig neue Beiträge, Rezepte und Ideen für das gute Familienleben direkt in dein Postfach." />
    </MediaText>
  </section>

  <section class="quote-feature" aria-label="Leitsatz">
    <QuoteBanner image={quote} imageAlt="Warmes Zuhause in sanften Pflaumen- und Erdtönen" icon="heart" signature="Danke, dass du dabei bist.">
      Domaće lebt von den Menschen, die hier lesen, teilen und sich austauschen.
    </QuoteBanner>
  </section>
</BaseLayout>

<style>
  .eyebrow { color: var(--color-action); font-size: var(--text-xs); font-weight: var(--font-weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .signature { font-family: var(--font-script); font-size: var(--text-lg); }
  .story-section { display: grid; gap: var(--space-12); grid-template-columns: minmax(16rem, 36%) minmax(0, 1fr); padding-block: var(--space-12); }
  .story-section__media { min-height: 34rem; overflow: hidden; position: relative; }
  .story-section__media :global(picture) { inset: 0; position: absolute; }
  .story-section__media :global(picture), .story-section__media :global(img) { height: 100%; width: 100%; }
  .story-section__media :global(img) { object-fit: cover; }
  .story-section__copy { align-self: center; }
  .story-section__copy > p:not(.eyebrow) { line-height: var(--leading-relaxed); margin-top: var(--space-4); }
  .value-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); list-style: none; margin-top: var(--space-8); padding: 0; }
  .value-list li { align-items: center; border-left: var(--divider-thickness) solid var(--color-border); display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-3); text-align: center; }
  .value-list li:first-child { border-left: 0; }
  .value-list :global(svg) { color: var(--color-olive-dark); }
  .value-list span { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .author-story { display: grid; grid-template-columns: 36% 64%; padding-bottom: var(--space-12); }
  .author-story__copy { align-self: center; padding: var(--space-10) var(--space-8) var(--space-10) 0; }
  .author-story__copy > p:not(.eyebrow, .signature) { line-height: var(--leading-relaxed); margin-top: var(--space-4); }
  .signature { margin-top: var(--space-6); }
  .author-story__media { min-height: 36rem; overflow: hidden; position: relative; }
  .author-story__media :global(picture), .author-story__media :global(img) { height: 100%; width: 100%; }
  .author-story__media :global(img) { object-fit: cover; }
  .facts-card { background: var(--color-surface); max-width: 16rem; padding: var(--space-5); position: absolute; right: var(--space-8); top: var(--space-8); width: calc(100% - (2 * var(--space-8))); }
  .facts-card ul { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .facts-card li { align-items: flex-start; display: flex; font-size: var(--text-sm); gap: var(--space-2); }
  .facts-card li + li { margin-top: var(--space-3); }
  .facts-card :global(svg) { color: var(--color-action); flex: 0 0 auto; margin-top: var(--space-1); }
  .quote-feature { margin-top: var(--space-12); }
  @media (max-width: 64rem) {
    .value-list { grid-template-columns: repeat(3, 1fr); }
    .value-list li:nth-child(4) { border-left: 0; }
  }
  @media (max-width: 44rem) {
    .story-section, .author-story { grid-template-columns: 1fr; }
    .welcome-hero__copy { padding-block: var(--space-12); }
    .story-section__media { min-height: 22rem; }
    .story-section { gap: var(--space-8); }
    .story-section__copy { padding-inline: var(--space-1); }
    .author-story__copy { padding: var(--space-10) 0; }
    .author-story__media { display: grid; min-height: 0; padding: var(--space-4); }
    .author-story__media :global(picture) { inset: 0; position: absolute; }
    .facts-card { align-self: start; justify-self: end; left: auto; max-width: 15rem; position: relative; right: auto; top: auto; width: 100%; }
  }
  @media (max-width: 34rem) {
    .value-list { grid-template-columns: repeat(2, 1fr); }
    .value-list li:nth-child(odd) { border-left: 0; }
    .value-list li:nth-child(4) { border-left: var(--divider-thickness) solid var(--color-border); }
  }
</style>