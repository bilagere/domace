---
import RecipeLayout from "../../components/layout/RecipeLayout.astro";
import { relatedContent } from "../../data/relatedContent";

const ingredients = [
  "600 g Rinderhüfte oder Rinderfilet",
  "250 g braune Champignons",
  "1 große Zwiebel",
  "2 kleine Gewürzgurken",
  "2 EL Butterschmalz oder neutrales Öl",
  "1 EL Tomatenmark",
  "1 TL edelsüßes Paprikapulver",
  "1 EL mittelscharfer Senf",
  "150 ml Rinderfond",
  "150 g Crème fraîche oder saure Sahne",
  "Salz und frisch gemahlener Pfeffer",
  "etwas glatte Petersilie zum Servieren",
];

const steps = [
  "Das Fleisch quer zur Faser in dünne Streifen schneiden. Champignons in Scheiben, Zwiebel in feine Halbringe und Gewürzgurken in schmale Streifen schneiden.",
  "Eine große Pfanne sehr heiß werden lassen. Die Hälfte des Butterschmalzes hineingeben und das Fleisch portionsweise jeweils nur ein bis zwei Minuten kräftig anbraten. Herausnehmen, salzen und beiseitestellen.",
  "Das restliche Butterschmalz in die Pfanne geben. Zwiebel und Champignons bei mittlerer bis hoher Hitze fünf bis sieben Minuten braten, bis die Pilze gebräunt sind.",
  "Tomatenmark und Paprikapulver kurz mitrösten. Senf einrühren und mit dem Rinderfond ablöschen.",
  "Die Sauce drei bis fünf Minuten leicht einkochen lassen. Die Hitze reduzieren und Crème fraîche glatt einrühren.",
  "Fleisch und Gewürzgurken zurück in die Pfanne geben und nur noch zwei Minuten in der heißen Sauce ziehen lassen. Die Sauce soll jetzt nicht mehr stark kochen.",
  "Mit Salz und Pfeffer abschmecken und mit Petersilie bestreuen. Dazu passen Reis, Bandnudeln oder Kartoffelpüree.",
];
---

<RecipeLayout
  pageTitle="Boeuf Stroganoff – Domaće"
  description="Cremiges Boeuf Stroganoff mit zartem Rindfleisch, Champignons und Gewürzgurken als wärmendes Familiengericht."
  category="Familienküche"
  title="Boeuf Stroganoff"
  summary="Zartes Rindfleisch, gebräunte Champignons und eine cremige, leicht würzige Sauce – ein Familiengericht, das besonders schmeckt und trotzdem in weniger als einer Stunde auf dem Tisch steht."
  imagePlaceholder="Bildplatzhalter · Boeuf Stroganoff"
  meta={[
    { icon: "clock", label: "Vorbereitung", value: "20 Minuten" },
    { icon: "clock", label: "Kochzeit", value: "25 Minuten" },
    { icon: "users", label: "Ergibt", value: "4 Portionen" },
  ]}
  ingredients={ingredients}
  ingredientNote="Schneide das Fleisch quer zur Faser und brate es in kleinen Portionen sehr kurz an. So bleibt es zart und zieht kein Wasser."
  tipTitle="Die Sauce nicht mehr kochen."
  tipText="Nachdem Crème fraîche und Fleisch in der Pfanne sind, soll das Stroganoff nur noch sanft erhitzt werden. Starkes Kochen macht das Fleisch fester und kann die Sauce trennen."
  steps={steps}
  relatedItems={relatedContent.boeufStroganoff}
>
  <Fragment slot="intro">
    <p>Boeuf Stroganoff ist ein cremiges Pfannengericht mit genau der richtigen Mischung aus herzhaft, mild und leicht säuerlich. Weil das Fleisch nur kurz gebraten wird, ist es schneller fertig, als der Name vermuten lässt.</p>
    <h2>Ein besonderes Essen ohne langen Küchenabend</h2>
    <p>Bereite alle Zutaten vor, bevor die Pfanne heiß wird. Danach geht alles zügig. Reis oder Nudeln können währenddessen nebenbei garen.</p>
  </Fragment>

  <h2>Was dazu passt</h2>
  <p>Bandnudeln nehmen die cremige Sauce besonders gut auf. Reis macht das Gericht etwas leichter, Kartoffelpüree besonders gemütlich. Ein einfacher Gurken- oder Blattsalat bringt Frische dazu.</p>
  <blockquote>Ein gutes Familiengericht muss nicht kompliziert sein – nur so gekocht, dass alle gerne an den Tisch kommen.</blockquote>
</RecipeLayout>