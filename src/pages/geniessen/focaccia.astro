---
import RecipeLayout from "../../components/layout/RecipeLayout.astro";
import { relatedContent } from "../../data/relatedContent";
import focaccia from "../../assets/images/focaccia.png";

const ingredients = [
  "500 g Weizenmehl (Type 550)",
  "400 ml lauwarmes Wasser",
  "7 g Trockenhefe",
  "10 g Salz",
  "3 EL Olivenöl plus etwas mehr für Form und Oberfläche",
  "1 Zweig Rosmarin",
  "eine kleine Handvoll grüne oder schwarze Oliven",
  "grobes Meersalz",
];

const steps = [
  "Wasser und Trockenhefe in einer großen Schüssel verrühren. Mehl und Salz dazugeben und alles mit einem Holzlöffel oder Teigschaber zu einem sehr weichen, klebrigen Teig vermengen.",
  "Den Teig in der Schüssel viermal im Abstand von jeweils 15 Minuten von außen zur Mitte falten. Dafür die Hände leicht anfeuchten, eine Teigseite hochziehen und über die Mitte legen.",
  "Die Schüssel abdecken und den Teig an einem warmen Ort etwa 60 bis 90 Minuten gehen lassen, bis er deutlich an Volumen gewonnen hat.",
  "Eine Backform oder ein kleines Blech großzügig mit Olivenöl ausstreichen. Den Teig hineingleiten lassen, vorsichtig auseinanderziehen und weitere 30 Minuten ruhen lassen.",
  "Den Backofen auf 220 °C Ober-/Unterhitze vorheizen. Die Fingerspitzen einölen und tiefe Mulden in den Teig drücken.",
  "Rosmarin und Oliven auf der Oberfläche verteilen. Mit Olivenöl beträufeln und mit etwas grobem Meersalz bestreuen.",
  "Die Focaccia 22 bis 28 Minuten backen, bis sie goldbraun ist. Vor dem Anschneiden mindestens 10 Minuten auf einem Gitter auskühlen lassen.",
];
---

<RecipeLayout
  pageTitle="Focaccia mit Rosmarin und Oliven – Domaće"
  description="Ein einfaches Rezept für luftige Focaccia mit knuspriger Kruste, Rosmarin und Oliven."
  category="Brot & Gebäck"
  title="Focaccia mit Rosmarin und Oliven"
  summary="Außen goldbraun und knusprig, innen weich und luftig – eine unkomplizierte Focaccia für den Familientisch, Gäste oder den nächsten gemütlichen Abend."
  image={focaccia}
  imageAlt="Goldbraune Focaccia mit Rosmarin und Oliven"
  meta={[
    { icon: "clock", label: "Arbeitszeit", value: "20 Minuten" },
    { icon: "clock", label: "Ruhe- & Backzeit", value: "ca. 2 Stunden" },
    { icon: "users", label: "Ergibt", value: "4–6 Portionen" },
  ]}
  ingredients={ingredients}
  ingredientNote="Der hohe Wasseranteil macht den Teig besonders luftig. Gib möglichst kein zusätzliches Mehl dazu – klebrige Hände sind hier genau richtig."
  tipTitle="So wird sie besonders gut."
  tipText="Plane genügend Ruhezeit ein und gehe sanft mit dem aufgegangenen Teig um. So bleiben die Luftblasen erhalten."
  steps={steps}
  relatedItems={relatedContent.focaccia}
>
  <Fragment slot="intro">
    <p>Focaccia gehört zu den Rezepten, die nach mehr Aufwand aussehen, als sie tatsächlich machen. Der Teig wird nicht geknetet, sondern nur einige Male gefaltet. Danach braucht er vor allem Zeit – und genau die sorgt für die luftige Krume.</p>
    <h2>Ein Brot für die Mitte des Tisches</h2>
    <p>Wir essen die Focaccia am liebsten noch leicht warm. Sie passt zu Suppe und Salat, kann mit Gemüse oder Käse belegt werden und ist auch am nächsten Tag kurz aufgebacken noch wunderbar.</p>
  </Fragment>

  <h2>Varianten für jede Jahreszeit</h2>
  <p>Im Sommer schmecken kleine Tomaten und Thymian darauf, im Herbst dünne Kürbisscheiben und Salbei. Für Kinder kannst du einen Teil schlicht mit Olivenöl und wenig Salz lassen.</p>
  <blockquote>Das beste Brot ist oft das, das in der Mitte des Tisches liegt und von allen geteilt wird.</blockquote>
</RecipeLayout>