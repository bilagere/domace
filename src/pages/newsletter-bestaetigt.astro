---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/layout/EditorialHero.astro";
import Button from "../components/ui/Button.astro";
import newsletterImage from "../assets/images/newsletter-feature.png";
---

<BaseLayout
  title="Newsletter bestätigt – Domaće"
  description="Deine Anmeldung zum Domaće-Newsletter wurde erfolgreich bestätigt."
  noindex
  footerFlush
>
  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    eyebrow="Willkommen bei Domaće"
    title={`Schön, dass du
dabei bist.`}
    image={newsletterImage}
    imageAlt="Kaffeetasse auf einem hellen Holztisch"
  >
    <Fragment slot="description">
      <p>Deine Anmeldung ist bestätigt.</p>
      <p>Mach es dir gemütlich – die nächste Post von Domaće findet ihren Weg zu dir.</p>
      <div class="confirmation__actions">
        <Button href="/journal">Zum Journal</Button>
        <Button href="/geniessen">Zum Genuss</Button>
      </div>
    </Fragment>
  </EditorialHero>
</BaseLayout>

<style>
  .confirmation__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
</style>
