---
import JournalOverview from "../../components/layout/JournalOverview.astro";
import { journalCategories, type JournalCategory } from "../../data/taxonomy";

export function getStaticPaths() {
  return journalCategories.map(({ category }) => ({
    params: { category },
    props: { category: category satisfies JournalCategory },
  }));
}

interface Props { category: JournalCategory; }
const { category } = Astro.props;
---

<JournalOverview activeCategory={category} />
