---
import GenussOverview from "../../components/layout/GenussOverview.astro";
import { recipeCategories, type RecipeCategory } from "../../data/taxonomy";

export function getStaticPaths() {
  return recipeCategories.map(({ category }) => ({ params: { category }, props: { category: category satisfies RecipeCategory } }));
}

interface Props { category: RecipeCategory; }
const { category } = Astro.props;
---

<GenussOverview activeCategory={category} />
