---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/layout/EditorialHero.astro";
import Button from "../components/ui/Button.astro";
import newsletterImage from "../assets/images/newsletter-feature.png";
---

<BaseLayout
  lang="en"
  title="Subscription confirmed – Domaće"
  description="Your subscription to Letters from Home is confirmed. Make yourself at home."
  noindex
  footerFlush
>
  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    eyebrow="LETTERS FROM HOME"
    title={"Grab a chair.\nMake yourself at home."}
    image={newsletterImage}
    imageAlt="A coffee cup on a light wooden table"
  >
    <Fragment slot="description">
      <p>Your subscription is confirmed. The next letter from my kitchen table will find its way to your inbox.</p>
      <p>Until then, there’s plenty to read and good things to cook.</p>
      <div class="confirmation__actions">
        <Button href="/journal">EXPLORE THE JOURNAL</Button>
        <Button href="/kitchen">COME TO THE KITCHEN</Button>
      </div>
    </Fragment>
  </EditorialHero>
</BaseLayout>

<style>
  .confirmation__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
</style>
