---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import EditorialHero from "../components/layout/EditorialHero.astro";
import Icon from "../components/ui/Icon.astro";
import OptimizedImage from "../components/ui/OptimizedImage.astro";
import MediaText from "../components/ui/MediaText.astro";
import NewsletterSignup from "../components/ui/NewsletterSignup.astro";
import QuoteBanner from "../components/ui/QuoteBanner.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import author from "../assets/images/autorin-mara.png";
import heroAbout from "../assets/images/hero-about.png";
import tableAtWindow from "../assets/images/tisch-am-fenster.png";
import newsletter from "../assets/images/newsletter-feature.png";
import quote from "../assets/images/quote-about.png";

const values = [
  { icon: "heart-handshake" as const, label: "Honest thoughts" },
  { icon: "salad" as const, label: "Everyday recipes" },
  { icon: "sparkles" as const, label: "Practical ideas" },
  { icon: "party-popper" as const, label: "Family traditions" },
  { icon: "users" as const, label: "A lived-in home" },
];

const facts = [
  "Coffee first. Preferably while it’s still hot.",
  "There is almost always dough rising somewhere in the kitchen.",
  "A full pantry makes me disproportionately happy.",
  "I’ll choose a walk in the woods over an hour on my phone any day.",
  "I make plans for everything and regularly change them.",
  "Guests who stay longer than planned are my kind of guests.",
  "If you come for dinner, I’ll probably make too much.",
];
---

<BaseLayout
  lang="en"
  title="About Domaće"
  description="Meet Mara, the person behind Domaće. Croatian roots, life in the Austrian Alps, and a love of food, family and home."
  activePath="/about"
>
  <Container>
    <section class="story-section" aria-labelledby="story-title">
      <div class="story-section__media">
        <OptimizedImage src={tableAtWindow} alt="A wooden table set beside a bright window" widths={[480, 720, 960]} sizes="(max-width: 704px) 100vw, 36vw" />
      </div>
      <div class="story-section__copy">
        <SectionHeading eyebrow="CROATIAN ROOTS · AUSTRIAN ALPS" id="story-title">What does domaće mean?</SectionHeading>
        <p>In Croatian, <em>domaće</em> can mean homemade, homegrown or simply something that comes from home.</p>
        <p>To me, it’s the food we make for the people we love, the traditions we carry with us and all the small things we do to make a house feel like ours.</p>
        <p>That’s really where Domaće began. Somewhere between cooking for my family, raising two girls and figuring out how to make our days work, I started writing things down. Recipes worth keeping, routines that actually helped, traditions I wanted to pass on and thoughts I didn’t want to lose.</p>
        <p>Over time, those notes became this place.</p>
        <ul class="value-list">
          {values.map((value) => (
            <li><Icon name={value.icon} size={28} /><span>{value.label}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="author-story" aria-labelledby="author-title">
      <div class="author-story__copy">
        <SectionHeading eyebrow="THE PERSON BEHIND THE WORDS" id="author-title">My name is Mara.</SectionHeading>
        <p>I’m a mother of two, homemaker, enthusiastic home cook and gardener. I grew up with Croatian food and traditions and now live with my family in a small town in the Austrian Alps.</p>
        <p>I’m happiest when I’m making something. Dinner, bread, plans for the garden or a gathering with the people I love. I like old recipes, useful things, full pantries and homes that don’t mind showing signs of the people who live in them.</p>
        <p>I plan a lot, improvise almost as much, and firmly believe that a good meal can fix a surprising number of things.</p>
        <p class="signature">With love,<br />Mara</p>
      </div>
      <div class="author-story__media">
        <OptimizedImage src={author} alt="Portrait of Mara holding a cup" widths={[480, 720, 960]} sizes="(max-width: 704px) 100vw, 56vw" />
        <aside class="facts-card" aria-label="A few things about Mara">
          <p class="eyebrow">A FEW THINGS ABOUT ME</p>
          <ul>{facts.map((fact) => <li><Icon name="heart" size={14} /><span>{fact}</span></li>)}</ul>
        </aside>
      </div>
    </section>
  </Container>

  <EditorialHero
    variant="homepage"
    showTitleIcon={false}
    narrowContent
    eyebrow="HOME, AS WE LIVE IT"
    title="The making of a home never really ends."
    image={heroAbout}
    imageAlt="A warm glimpse into Mara’s home"
  >
    <Fragment slot="description">
      <p>There is always something cooking, growing, changing or needing to be done. Somewhere in between, traditions take shape, children grow up and an ordinary day becomes part of a family’s story.</p>
    </Fragment>
  </EditorialHero>

  <section class="newsletter-feature" aria-label="Newsletter">
    <MediaText image={newsletter} imageAlt="A coffee cup on a light wooden table" ratio="media-40" variant="newsletter">
      <NewsletterSignup compact />
    </MediaText>
  </section>

  <section class="quote-feature" aria-label="A thought to share">
    <QuoteBanner image={quote} imageAlt="A warm home in soft plum and earth tones" icon="heart">
      There’s always room<br />for one more at the table.
    </QuoteBanner>
  </section>
</BaseLayout>

<style>
  .eyebrow { color: var(--color-action); font-size: var(--text-xs); font-weight: var(--font-weight-bold); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .signature { font-family: var(--font-sans); font-size: var(--text-base); }
  .story-section { display: grid; gap: var(--space-12); grid-template-columns: minmax(16rem, 36%) minmax(0, 1fr); padding-block: var(--space-12); }
  .story-section__media { min-height: 34rem; overflow: hidden; position: relative; }
  .story-section__media :global(picture) { inset: 0; position: absolute; }
  .story-section__media :global(picture), .story-section__media :global(img) { height: 100%; width: 100%; }
  .story-section__media :global(img) { object-fit: cover; }
  .story-section__copy { align-self: center; }
  .story-section__copy > p:not(.eyebrow) { line-height: var(--leading-relaxed); margin-top: var(--space-4); }
  .value-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); list-style: none; margin-top: var(--space-8); padding: 0; }
  .value-list li { align-items: center; border-left: var(--divider-thickness) solid var(--color-border); display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-3); text-align: center; }
  .value-list li:first-child { border-left: 0; }
  .value-list :global(svg) { color: var(--color-olive-ink); }
  .value-list span { font-size: var(--text-xs); font-weight: var(--font-weight-semibold); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .author-story { display: grid; grid-template-columns: 36% 64%; padding-bottom: var(--space-12); }
  .author-story__copy { align-self: center; padding: var(--space-10) var(--space-8) var(--space-10) 0; }
  .author-story__copy > p:not(.eyebrow, .signature) { line-height: var(--leading-relaxed); margin-top: var(--space-4); }
  .signature { margin-top: var(--space-6); }
  .author-story__media { min-height: 36rem; overflow: hidden; position: relative; }
  .author-story__media :global(picture), .author-story__media :global(img) { height: 100%; width: 100%; }
  .author-story__media :global(img) { object-fit: cover; }
  .facts-card { background: var(--color-surface); max-width: 16rem; padding: var(--space-5); position: absolute; right: var(--space-8); top: var(--space-8); width: calc(100% - (2 * var(--space-8))); }
  .facts-card ul { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .facts-card li { align-items: flex-start; display: flex; font-size: var(--text-sm); gap: var(--space-2); }
  .facts-card li + li { margin-top: var(--space-3); }
  .facts-card :global(svg) { color: var(--color-action); flex: 0 0 auto; margin-top: var(--space-1); }
  .quote-feature, .newsletter-feature { margin-top: var(--space-12); }
  @media (max-width: 64rem) {
    .value-list { grid-template-columns: repeat(3, 1fr); }
    .value-list li:nth-child(4) { border-left: 0; }
  }
  @media (max-width: 44rem) {
    .story-section, .author-story { grid-template-columns: 1fr; }
    .welcome-hero__copy { padding-block: var(--space-12); }
    .story-section__media { min-height: 22rem; }
    .story-section { gap: var(--space-8); }
    .story-section__copy { padding-inline: var(--space-1); }
    .author-story__copy { padding: var(--space-10) 0; }
    .author-story__media { display: grid; min-height: 0; padding: var(--space-4); }
    .author-story__media :global(picture) { inset: 0; position: absolute; }
    .facts-card { align-self: start; justify-self: end; left: auto; max-width: 15rem; position: relative; right: auto; top: auto; width: 100%; }
  }
  @media (max-width: 34rem) {
    .value-list { grid-template-columns: repeat(2, 1fr); }
    .value-list li:nth-child(odd) { border-left: 0; }
    .value-list li:nth-child(4) { border-left: var(--divider-thickness) solid var(--color-border); }
  }
</style>
