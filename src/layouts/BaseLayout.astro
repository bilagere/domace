---
import "@fontsource-variable/manrope";

import "../design/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import type { ImageMetadata } from "astro";
import instagramOne from "../assets/images/ankommen_homepage.png";
import instagramTwo from "../assets/images/newsletter-feature.png";
import instagramThree from "../assets/images/enjoy.png";

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  footerGallery?: ImageMetadata[];
  footerFlush?: boolean;
}

const {
  title,
  description = "Domaće – für das gute Familienleben.",
  activePath,
  footerGallery = [instagramOne, instagramTwo, instagramThree],
  footerFlush = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:site_name" content="Domaće" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
    <SiteHeader activePath={activePath} />
    <main id="main-content"><slot /></main>
    <SiteFooter gallery={footerGallery} flush={footerFlush} />
  </body>
</html>
