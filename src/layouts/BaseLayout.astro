---
import "@fontsource-variable/manrope";

import "../design/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import type { ImageMetadata } from "astro";
import instagramOne from "../assets/images/ankommen_homepage.png";
import instagramTwo from "../assets/images/newsletter-feature.png";
import instagramThree from "../assets/images/enjoy.png";

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  footerGallery?: ImageMetadata[];
}

const {
  title,
  description = "Domaće – für das gute Familienleben.",
  activePath,
  footerGallery = [instagramOne, instagramTwo, instagramThree],
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
    <SiteHeader activePath={activePath} />
    <main id="main-content"><slot /></main>
    <SiteFooter gallery={footerGallery} />
  </body>
</html>
