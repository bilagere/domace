---
import "@fontsource-variable/manrope";
import "@fontsource-variable/bodoni-moda";

import "../design/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import instagramOne from "../assets/images/ankommen_homepage.png";
import instagramTwo from "../assets/images/newsletter-feature.png";
import instagramThree from "../assets/images/enjoy.png";
import ogImageSource from "../assets/images/og-image.png";

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  footerGallery?: ImageMetadata[];
  footerFlush?: boolean;
  noindex?: boolean;
  socialImage?: ImageMetadata;
  socialImageAlt?: string;
  socialType?: "website" | "article";
  socialTitle?: string;
  socialDescription?: string;
  articleAuthor?: string;
  articlePublishedTime?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "Domaće – für das gute Familienleben.",
  activePath,
  footerGallery = [instagramOne, instagramTwo, instagramThree],
  footerFlush = false,
  noindex = false,
  socialImage = ogImageSource,
  socialImageAlt = "Domaće – für das gute Familienleben",
  socialType = "website",
  socialTitle = title,
  socialDescription = description,
  articleAuthor,
  articlePublishedTime,
  structuredData,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({
  src: socialImage,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 82,
  fit: "cover",
});
const ogImageUrl = new URL(ogImage.src, Astro.site);
const completeStructuredData = structuredData
  ? {
      "@context": "https://schema.org",
      url: canonicalUrl.href,
      image: ogImageUrl.href,
      ...structuredData,
    }
  : undefined;
const structuredDataJson = completeStructuredData
  ? JSON.stringify(completeStructuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="p:domain_verify" content="0df0b1419a65fabd34e0e2466a61cd6b" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f2ec" />
    <meta property="og:site_name" content="Domaće" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
    <title>{title}</title>
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="8cc17624-efc9-44ae-80cb-fccc1b869eb3"
      data-domains="domace.studio,www.domace.studio"
      data-performance="true"
    ></script>
    <script is:inline type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Hauptinhalt springen</a>
    <SiteHeader activePath={activePath} />
    <main id="main-content"><slot /></main>
    <SiteFooter gallery={footerGallery} flush={footerFlush} />
  </body>
</html>
